{
  "name": "fractalpark",
  "version": "0.4.18",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:webgl-smoke": "SKIP_WEB_SERVER=1 playwright test frm-webgl-smoke --workers=1",
    "formula:bulk-migration": "tsx scripts/formula-library-bulk-migration.ts",
    "formula:provisional-assets": "tsx scripts/formula-library-bulk-migration.ts --provisional-assets --write",
    "formula:publication-readiness": "tsx scripts/generate-formula-publication-readiness.ts --write",
    "formula:publication-readiness:verify": "tsx scripts/verify-formula-publication-readiness.ts",
    "formula:publication-decisions": "tsx scripts/generate-formula-publication-decisions.ts",
    "formula:publication-decisions:write": "tsx scripts/generate-formula-publication-decisions.ts --write",
    "formula:publication-decisions:verify": "tsx scripts/verify-formula-publication-decisions.ts",
    "formula:runtime-rev4": "tsx scripts/build-formula-runtime-rev4.ts",
    "formula:runtime-rev4:write": "tsx scripts/build-formula-runtime-rev4.ts --write",
    "formula:runtime-rev4:verify": "tsx scripts/verify-formula-runtime-rev4.ts",
    "formula:published-runtime": "tsx scripts/build-published-formula-runtime.ts",
    "formula:published-runtime:write": "tsx scripts/build-published-formula-runtime.ts --write",
    "formula:published-runtime:webgl": "tsx scripts/verify-published-formula-runtime-webgl.ts",
    "formula:published-runtime:webgl:reports": "tsx scripts/verify-published-formula-webgl-reports.ts",
    "formula:native-recipes:cross-check": "tsx scripts/cross-check-native-recipes.ts",
    "formula:direct-adaptation-evidence": "tsx scripts/generate-formula-direct-adaptation-evidence.ts --write",
    "formula:direct-adaptation-evidence:verify": "tsx scripts/verify-formula-direct-adaptation-evidence.ts",
    "formula:clean-room-evidence": "tsx scripts/generate-formula-clean-room-evidence.ts --write",
    "formula:clean-room-evidence:verify": "tsx scripts/verify-formula-clean-room-evidence.ts",
    "thumbnails:presets": "node scripts/generate-thumbnails.mjs",
    "images:formula-guides": "node --import tsx scripts/generate-formula-guide-images.ts",
    "indexnow:submit": "node --import tsx scripts/submit-indexnow.ts",
    "myfrac:cli": "node --import tsx scripts/myfrac-cli.ts",
    "readme:generate": "node --import tsx scripts/generate-readme.ts --write",
    "readme:check": "node --import tsx scripts/generate-readme.ts --check",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "node --import tsx scripts/cloud-migrate.ts",
    "db:preflight": "node --import tsx scripts/cloud-preflight.ts",
    "db:test": "node --import tsx scripts/cloud-schema-test.ts",
    "cleanup:worker": "node --import tsx scripts/cleanup-worker.ts",
    "backup:cloud": "node --import tsx scripts/backup-cloud.ts",
    "restore:cloud": "node --import tsx scripts/restore-cloud.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/language": "^6.12.1",
    "@codemirror/lint": "^6.9.4",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.15",
    "@lezer/common": "^1.5.1",
    "@lezer/highlight": "^1.2.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.18.1",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "next-intl": "^4.8.2",
    "next-themes": "^0.4.6",
    "nodemailer": "9.0.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "puppeteer": "^24.37.3",
    "raw-loader": "^4.0.2",
    "shadcn": "^3.8.4",
    "supabase": "2.111.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "license": "MIT",
  "description": "A browser-based WebGL fractal art explorer built with Next.js, React, TypeScript, and GLSL shaders.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noodle-bag/fractalpark.git"
  },
  "bugs": {
    "url": "https://github.com/noodle-bag/fractalpark/issues"
  },
  "homepage": "https://www.fractalpark.com"
}
