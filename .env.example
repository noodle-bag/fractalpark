# Optional analytics and deployment configuration can be added by the deployer.
# Do not commit real secrets.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional IndexNow integration.
# Generate an 8-128 character key and set the same value in Vercel before running:
# npm run indexnow:submit -- --base-url https://www.fractalpark.com
INDEXNOW_KEY=

# -----------------------------------------------------------------------------
# Web creation loop (v0.4.15) — all variables below are server-only.
# Contract: docs/specs/web-creation-loop-v1.md section 1.
# Never use NEXT_PUBLIC_ variants, never commit real values, and never print
# values in logs. With every variable absent, the site builds and runs exactly
# as before with the cloud creation loop disabled.
# -----------------------------------------------------------------------------

# Master switch for the cloud creation loop. Anything other than the exact
# string "true" means off. Keep unset in Production and ordinary previews.
FRACTALPARK_CREATION_CLOUD_ENABLED=

# Supabase project connection (set only where the cloud loop is enabled).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service role key: server-only admin operations (health check, cleanup,
# account deletion final stage). Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Authenticated-encryption key for the sealed session cookie
# (generate 32+ random bytes, e.g. `openssl rand -base64 32`).
FRACTALPARK_SESSION_ENCRYPTION_KEY=

# HMAC key for rate-limit subject hashing (emails/IPs are never stored raw).
FRACTALPARK_RATE_LIMIT_HMAC_KEY=

# Protects the daily health-check cron endpoint.
CRON_SECRET=

# Independent switch for artwork backup emails; requires the master switch.
FRACTALPARK_ARTWORK_EMAIL_BACKUP_ENABLED=

# Transactional SMTP for artwork backup emails (OTP uses the auth provider's
# own email settings; these credentials are independent of it).
FRACTALPARK_SMTP_HOST=
FRACTALPARK_SMTP_PORT=
FRACTALPARK_SMTP_USER=
FRACTALPARK_SMTP_PASSWORD=

# Postgres connection string for the controlled migration environment only.
# Lives exclusively in the migration owner's environment, never in Vercel
# runtime or preview variables.
SUPABASE_DB_URL=
