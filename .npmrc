# npmmirror does not mirror the @supabase/cli-* platform binaries, so the
# Supabase CLI and its platform packages resolve from the official registry.
@supabase:registry=https://registry.npmjs.org/

# Keep the lockfile's resolved URLs verbatim: without this, npm rewrites the
# npmjs.org hosts above to the default registry and the tarball fetches 404.
replace-registry-host=never
